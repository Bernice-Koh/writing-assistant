# --- Secrets ---------------------------------------------------------------
# Anthropic and AWS credentials
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12
secrets.json
credentials.json

# --- Private working material ------------------------------------------------
_local/

# --- Rust / Tauri ----------------------------------------------------------
target/
**/*.rs.bk
*.pdb
src-tauri/gen/
src-tauri/target/
# Regenerated on every build by build.rs's `AppManifest::commands(...)`; a hand-authored
# permission would live directly under src-tauri/permissions/, not this subfolder.
src-tauri/permissions/autogenerated/

# Tauri updater signing keys
*.key
tauri.conf.local.json

# --- Node / frontend -------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Browser extension builds -----------------------------------------------
extension/dist/
extension/*.zip

# --- Adapter training ---------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- Large binaries: fetched or generated, never committed -----------------
src-tauri/resources/languagetool-server.jar
# Contents only: both directories stay tracked, because tauri.conf.json lists them as bundled
# resources and a resource path missing at build time fails the build outright. A fresh checkout
# gets them empty, and LanguageTool degrades to spelling and AI-tell flags until
# scripts/build-languagetool-jre.ps1 fills them.
src-tauri/resources/languagetool/*
!src-tauri/resources/languagetool/.gitkeep
# Bundled Java runtime produced by jlink
src-tauri/resources/jre/*
!src-tauri/resources/jre/.gitkeep
# Model weights, quantizations, and trained adapters
*.gguf
*.onnx
*.safetensors
*.bin
adapter/artifacts/
adapter/data/*.jsonl

# --- User data (lives in the per-user config dir, not the repo) -------
# Style Card, profiles, exemplar corpus, and training pairs are personal.
*.sqlite
*.sqlite3
*.db
style-card.md
corpus/
profiles/

# --- Installer output ------------------------------------------------------
*.msi
*.exe
*.nsis
bundle/

# --- Local scratch ----------------------------------------------------------
# `npm run tauri dev` redirected to a file. Debug-level capture logging makes it large
# fast, and nothing in it belongs in the repository.
dev.log

# --- Editors and OS --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
