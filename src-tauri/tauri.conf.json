{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writing Assistant",
  "version": "0.1.0",
  "identifier": "com.bernicekoh.writing-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Writing Assistant",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
