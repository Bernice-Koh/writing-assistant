  {
    "id": "negative-parallelism",
    "category": "language-and-grammar",
    "description": "The \"it's not just X, it's Y\" construction, overused as a rhetorical device",
    "matcher": {
      "kind": "regex",
      "source": "(?i)\\bit['\\x{2019}]?s not (?:just|merely|only)\\b[^,.;]{1,80}?,?\\s*it['\\x{2019}]?s\\b"
    },
    "unit": "span",
    "band": { "kind": "forbidden" },
    "formModes": ["prose", "fragment"],
    "raw": false,
    "source": "humanizer SKILL.md section 9, Wikipedia:Signs of AI writing"
