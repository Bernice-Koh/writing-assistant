  {
    "id": "superficial-ing-endings",
    "category": "content",
    "description": "Tacks a present-participle clause onto a sentence for fake depth rather than a real point",
    "matcher": {
      "kind": "regex",
      "source": ",\\s*(highlighting|underscoring|emphasi[sz]ing|ensuring|reflecting|symboli[sz]ing|contributing to|cultivating|fostering|encompassing|showcasing)\\b"
    },
    "unit": "span",
    "band": { "kind": "forbidden" },
    "formModes": ["prose", "fragment"],
    "raw": false,
    "source": "humanizer SKILL.md section 3, Wikipedia:Signs of AI writing"
